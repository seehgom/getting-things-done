# Clerk — https://dashboard.clerk.com/apps/app_3HpElL2NopGWbWfHjnyn4nZEK0g/instances/.../api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# When "true", /sign-up shows Clerk's <Waitlist /> instead of the sign-up
# form, so no new accounts can be created. Pair this with enabling
# "Waitlist" mode under Clerk Dashboard -> User & Authentication ->
# Restrictions so it's enforced by Clerk itself, not just hidden in the UI.
SIGNUPS_DISABLED=false

# Playwright e2e tests (`npm run test:e2e`) sign in through the real Clerk
# UI via @clerk/testing — no password/OTP needed, just an existing user's
# email on this Clerk instance. CLERK_SECRET_KEY above is reused to fetch
# the testing token and issue the sign-in.
E2E_CLERK_USER_EMAIL=

# Supabase project "thnk" — https://supabase.com/dashboard/project/aczftabzillgfhykozri/settings/api
SUPABASE_URL=https://aczftabzillgfhykozri.supabase.co
# Service role key — server-only, never exposed to the browser. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=
